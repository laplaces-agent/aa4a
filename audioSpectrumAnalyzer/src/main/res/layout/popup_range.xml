<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_popup"
    android:orientation="vertical"
    android:paddingLeft="14dp"
    android:paddingTop="10dp"
    android:paddingRight="14dp"
    android:paddingBottom="8dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/range_title"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:text="@string/range_top"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/range_top"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/range_top_value"
            style="@style/Readout"
            android:layout_width="64dp"
            android:gravity="end"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:text="@string/range_floor"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/range_floor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/range_floor_value"
            style="@style/Readout"
            android:layout_width="64dp"
            android:gravity="end"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/range_auto_hint"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/range_reset"
            style="@style/PopupButton"
            android:text="@string/range_reset" />

        <TextView
            android:id="@+id/range_auto"
            style="@style/PopupButton"
            android:layout_marginLeft="6dp"
            android:text="@string/range_auto"
            android:textColor="@color/accent" />
    </LinearLayout>
</LinearLayout>
